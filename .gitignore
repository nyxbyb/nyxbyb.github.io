# Python
.venv/
__pycache__/
*.pyc

# Node / 前端构建产物
node_modules/
web/dist/

# 系统
.DS_Store

# 爬虫中间产物与原始数据（可从脚本重新生成）
*.tsv
corpus/*.json
data/raw/
pipeline/raw/

# ⚠️ 私人精神语料：你的真实书评/文章/论文一律不进公开仓库
# （默认连 books/articles/papers 下的内容都排除，模板除外）
corpus/books/*
!corpus/books/_template.md
corpus/articles/*
!corpus/articles/_template.md
corpus/papers/*
!corpus/papers/_template.md

# 本地嵌入缓存（体积大，不入库）
*.npy
# ⚠️ 私人内容: 公众号/日记等一律不进公开仓库
data/公众号/
data/日记/
data/随笔/
data/私人/
# ⚠️ 私人阅读史: 微信读书记录/截图 不进公开仓库
data/微信读书/
